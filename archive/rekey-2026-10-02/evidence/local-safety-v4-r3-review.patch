new file mode 100644
index 0000000..497730b
--- /dev/null
+++ b/app/src-tauri/src/safe_service.rs
@@ -0,0 +1,662 @@
+//! Local safety fork: observed AX targets only; no global synthetic-key fallback.
+use crate::transaction::{self, Outcome, Phase, Target};
+use rekey_core::{
+    engine::{Action, Engine},
+    input::{Context, Key, KeyEvent},
+};
+use rekey_hook::{
+    focus::{Expected, Focus, Range, Watch},
+    platform,
+};
+use std::{
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        mpsc, Arc, Mutex, OnceLock,
+    },
+    time::Duration,
+};
+use tauri::AppHandle;
+pub type SharedEngine = Arc<Mutex<Engine>>;
+static SETTINGS_REVISION: AtomicU64 = AtomicU64::new(0);
+static WATCHES: OnceLock<Mutex<Vec<Watch>>> = OnceLock::new();
+pub fn invalidate_pending() {
+    SETTINGS_REVISION.fetch_add(1, Ordering::SeqCst);
+    if let Some(ws) = WATCHES.get() {
+        if let Ok(ws) = ws.lock() {
+            for w in ws.iter() {
+                w.clear();
+                w.invalidated.store(true, Ordering::SeqCst);
+            }
+        }
+    }
+}
+// A timed-out queued main-thread task is marked cancelled before it can mutate layout.
+fn on_main<T: Send + 'static>(
+    app: &AppHandle,
+    f: impl FnOnce(Arc<AtomicBool>) -> T + Send + 'static,
+) -> Option<T> {
+    let (tx, rx) = mpsc::channel();
+    let live = Arc::new(AtomicBool::new(true));
+    let active = live.clone();
+    app.run_on_main_thread(move || {
+        if active.load(Ordering::SeqCst) {
+            let result = f(active.clone());
+            let _ = tx.send(result);
+        }
+    })
+    .ok()?;
+    let result = rx.recv_timeout(Duration::from_millis(100)).ok();
+    if result.is_none() {
+        live.store(false, Ordering::SeqCst);
+    }
+    result
+}
+fn policy_context(app: &AppHandle) -> Option<(Context, i32)> {
+    on_main(app, |_| platform::current_context_with_pid()).flatten()
+}
+fn allowed(engine: &SharedEngine, ctx: &Context) -> bool {
+    let Ok(e) = engine.lock() else {
+        return false;
+    };
+    e.config().enabled
+        && !ctx.secure_input
+        && ctx
+            .app
+            .as_ref()
+            .is_some_and(|a| !e.config().is_excluded_app(a))
+}
+#[derive(Clone)]
+struct Track {
+    focus: Focus,
+    tail: String,
+    revision: u64,
+    synchronized: bool,
+}
+fn expectation(t: &Track) -> Option<Expected> {
+    let length = t.tail.encode_utf16().count();
+    if length > 128 || t.focus.caret < length {
+        return None;
+    }
+    Some(Expected {
+        focus: t.focus.clone(),
+        fragment_range: Range {
+            location: (t.focus.caret - length) as isize,
+            length: length as isize,
+        },
+        fragment: t.tail.clone(),
+        revision: t.revision,
+    })
+}
+fn state(t: &Track) -> crate::input_phase::State {
+    crate::input_phase::State {
+        caret: t.focus.caret,
+        tail: t.tail.clone(),
+    }
+}
+fn candidate(t: &Track, event: &KeyEvent) -> Option<Track> {
+    let after = crate::input_phase::advance(&state(t), event)?;
+    Some(Track {
+        focus: t.focus.with_range(Range {
+            location: after.caret as isize,
+            length: 0,
+        }),
+        tail: after.tail,
+        revision: t.revision,
+        synchronized: t.synchronized || event.key == Key::Space,
+    })
+}
+fn matches(t: &Track, focus: &Focus) -> bool {
+    expectation(t)
+        .is_some_and(|x| x.matches(focus, |r| SETTINGS_REVISION.load(Ordering::SeqCst) == r))
+}
+fn boundary_at(focus: &Focus, caret: usize, revision: u64) -> bool {
+    if SETTINGS_REVISION.load(Ordering::SeqCst) != revision {
+        return false;
+    }
+    let predecessor = if caret > 0 {
+        focus.fragment(Range {
+            location: (caret - 1) as isize,
+            length: 1,
+        })
+    } else {
+        None
+    };
+    crate::input_phase::known_boundary(caret, predecessor.as_deref())
+}
+/// Bootstrap has no confirmed old caret. Accept only one boundary-proven phase;
+/// post-event bootstrap additionally proves the exact just-inserted character.
+fn bootstrap(focus: &Focus, event: &KeyEvent, revision: u64) -> Option<(Track, Track)> {
+    if focus.selected != 0 {
+        return None;
+    }
+    let (before, after) = crate::input_phase::bootstrap(
+        focus.caret,
+        event,
+        |caret| boundary_at(focus, caret, revision),
+        |state| {
+            let t = Track {
+                focus: focus.with_range(Range {
+                    location: state.caret as isize,
+                    length: 0,
+                }),
+                tail: state.tail.clone(),
+                revision,
+                synchronized: true,
+            };
+            matches(&t, focus)
+        },
+    )?;
+    let make = |state: crate::input_phase::State| Track {
+        focus: focus.with_range(Range {
+            location: state.caret as isize,
+            length: 0,
+        }),
+        tail: state.tail,
+        revision,
+        synchronized: true,
+    };
+    Some((make(before), make(after)))
+}
+fn reset(engine: &SharedEngine, tracking: &Arc<Mutex<Option<Track>>>, watch: &Watch) {
+    if let Ok(mut e) = engine.lock() {
+        e.invalidate_caret();
+    }
+    if let Ok(mut t) = tracking.lock() {
+        *t = None;
+    }
+    watch.clear();
+}
+struct Pending {
+    action: Action,
+    origin: Focus,
+    generation: u64,
+    revision: u64,
+}
+struct AxTarget<'a> {
+    pending: &'a Pending,
+    range: Range,
+    text: &'a str,
+    original: &'a str,
+    app: &'a AppHandle,
+    engine: &'a SharedEngine,
+    generation: &'a AtomicU64,
+    running: &'a AtomicBool,
+    source_verified: bool,
+    selected_owned: bool,
+}
+impl Target for AxTarget<'_> {
+    fn guard(&mut self, phase: Phase) -> bool {
+        // Cleanup retains narrow authorization to restore our already-selected fragment.
+        // A settings change cancels writing but alone does not transfer caret ownership.
+        let owner = self.running.load(Ordering::SeqCst)
+            && self.generation.load(Ordering::SeqCst) == self.pending.generation
+            && !platform::secure_input_active();
+        if !owner {
+            return false;
+        }
+        if phase != Phase::Rollback
+            && SETTINGS_REVISION.load(Ordering::SeqCst) != self.pending.revision
+        {
+            return false;
+        }
+        if phase == Phase::BeforeSelection {
+            let Some((ctx, pid)) = policy_context(self.app) else {
+                return false;
+            };
+            if !allowed(self.engine, &ctx) || pid != self.pending.origin.pid {
+                return false;
+            }
+            let Some(now) = Focus::capture() else {
+                return false;
+            };
+            now.same_field(&self.pending.origin)
+                && now.selected == 0
+                && now.caret == self.pending.origin.caret
+                && self.generation.load(Ordering::SeqCst) == self.pending.generation
+                && SETTINGS_REVISION.load(Ordering::SeqCst) == self.pending.revision
+        } else {
+            // No main-thread wait, TIS/AppKit, engine mutex, or full role/window capture after selection.
+            self.pending.origin.still_focused()
+                && self.pending.origin.current_range() == Some(self.range)
+                && self.generation.load(Ordering::SeqCst) == self.pending.generation
+                && (phase == Phase::Rollback
+                    || SETTINGS_REVISION.load(Ordering::SeqCst) == self.pending.revision)
+        }
+    }
+    fn fragment(&mut self) -> Option<String> {
+        if SETTINGS_REVISION.load(Ordering::SeqCst) != self.pending.revision {
+            return None;
+        }
+        let source = self.pending.origin.fragment(self.range);
+        self.source_verified = source.as_deref() == Some(self.original);
+        source
+    }
+    fn select(&mut self) -> bool {
+        let ok =
+            self.guard(Phase::BeforeSelection) && self.pending.origin.set_selection(self.range);
+        self.selected_owned = ok;
+        ok
+    }
+    fn replace(&mut self) -> bool {
+        self.guard(Phase::BeforeReplacement)
+            && self.fragment().as_deref() == Some(self.original)
+            && self.guard(Phase::BeforeReplacement)
+            && self.pending.origin.set_selected_text(self.text)
+    }
+    fn rollback(&mut self) -> bool {
+        if !self.selected_owned || !self.source_verified || !self.guard(Phase::Rollback) {
+            return false;
+        }
+        if SETTINGS_REVISION.load(Ordering::SeqCst) == self.pending.revision {
+            if self.fragment().as_deref() != Some(self.original) || !self.guard(Phase::Rollback) {
+                return false;
+            }
+        }
+        // A config-only cancellation may collapse our exact owned range using metadata
+        // and the previously verified source, without any new text read while OFF.
+        // This never writes/deletes characters; focus/input/range changes prevent it.
+        self.guard(Phase::Rollback)
+            && self.pending.origin.set_selection(Range {
+                location: self.range.location + self.range.length,
+                length: 0,
+            })
+    }
+}
+pub fn spawn(
+    app: &AppHandle,
+    engine: SharedEngine,
+) -> Result<Arc<AtomicBool>, rekey_hook::HookError> {
+    let running = Arc::new(AtomicBool::new(false));
+    let generation = Arc::new(AtomicU64::new(0));
+    let tracking = Arc::new(Mutex::new(None::<Track>));
+    let watch = Watch::start(
+        generation.clone(),
+        Arc::new(|revision| SETTINGS_REVISION.load(Ordering::SeqCst) == revision),
+    )
+    .map_err(|e| rekey_hook::HookError::Os(e.to_string()))?;
+    if let Ok(mut ws) = WATCHES.get_or_init(|| Mutex::new(Vec::new())).lock() {
+        ws.push(watch.clone());
+    }
+    let (tx, rx) = mpsc::channel::<Pending>();
+    let handle = app.clone();
+    let gen = generation.clone();
+    let e = engine.clone();
+    let tracker = tracking.clone();
+    let w = watch.clone();
+    let alive = running.clone();
+    std::thread::Builder::new()
+        .name("rekey-safe-inject".into())
+        .spawn(move || {
+            for pending in rx {
+                std::thread::sleep(Duration::from_millis(25));
+                let Action::Replace {
+                    delete,
+                    text,
+                    switch_to,
+                    original,
+                } = &pending.action
+                else {
+                    continue;
+                };
+                let count = original.encode_utf16().count();
+                // The core deletion count must agree with this exact BMP source fragment.
+                if count != *delete
+                    || pending.origin.caret < count
+                    || count > 128
+                    || !w.ensure(&pending.origin)
+                {
+                    reset(&e, &tracker, &w);
+                    continue;
+                }
+                let range = Range {
+                    location: (pending.origin.caret - count) as isize,
+                    length: count as isize,
+                };
+                let selected = pending.origin.with_range(range);
+                let final_focus = pending.origin.with_range(Range {
+                    location: range.location + text.encode_utf16().count() as isize,
+                    length: 0,
+                });
+                // Allow only the exact original/own-selection/own-replacement transitions.
+                w.expect(vec![
+                    Expected {
+                        focus: pending.origin.clone(),
+                        fragment_range: range,
+                        fragment: original.clone(),
+                        revision: pending.revision,
+                    },
+                    Expected {
+                        focus: selected,
+                        fragment_range: range,
+                        fragment: original.clone(),
+                        revision: pending.revision,
+                    },
+                    Expected {
+                        focus: final_focus.clone(),
+                        fragment_range: Range {
+                            location: range.location,
+                            length: text.encode_utf16().count() as isize,
+                        },
+                        fragment: text.clone(),
+                        revision: pending.revision,
+                    },
+                ]);
+                let mut target = AxTarget {
+                    pending: &pending,
+                    range,
+                    text,
+                    original,
+                    app: &handle,
+                    engine: &e,
+                    generation: &gen,
+                    running: &alive,
+                    source_verified: false,
+                    selected_owned: false,
+                };
+                let outcome = transaction::execute(&mut target, original);
+                if outcome != Outcome::Replaced {
+                    if outcome == Outcome::SelectionNotRestored {
+                        log::warn!(
+                            "AX correction cancelled; selection restoration was unsafe and skipped"
+                        );
+                    }
+                    reset(&e, &tracker, &w);
+                    continue;
+                }
+                let Some(after) = Focus::capture() else {
+                    reset(&e, &tracker, &w);
+                    continue;
+                };
+                if !after.same_field(&final_focus)
+                    || after.selection() != final_focus.selection()
+                    || gen.load(Ordering::SeqCst) != pending.generation
+                    || SETTINGS_REVISION.load(Ordering::SeqCst) != pending.revision
+                {
+                    reset(&e, &tracker, &w);
+                    continue;
+                }
+                let mut layout_ok = switch_to.is_none();
+                if let Some(layout) = switch_to {
+                    let target_focus = after.clone();
+                    let target_text = text.clone();
+                    let start = range.location;
+                    let layout = layout.clone();
+                    let e = e.clone();
+                    let gen = gen.clone();
+                    let alive = alive.clone();
+                    let n = pending.generation;
+                    let revision = pending.revision;
+                    layout_ok = on_main(&handle, move |token| {
+                        let valid = || {
+                            token.load(Ordering::SeqCst)
+                                && alive.load(Ordering::SeqCst)
+                                && gen.load(Ordering::SeqCst) == n
+                                && SETTINGS_REVISION.load(Ordering::SeqCst) == revision
+                        };
+                        if !valid() || !allowed(&e, &platform::current_context()) {
+                            return false;
+                        }
+                        if !Focus::capture().is_some_and(|f| {
+                            f.same_field(&target_focus)
+                                && f.selection() == target_focus.selection()
+                                && f.fragment(Range {
+                                    location: start,
+                                    length: target_text.encode_utf16().count() as isize,
+                                })
+                                .as_deref()
+                                    == Some(target_text.as_str())
+                        }) || !valid()
+                        {
+                            return false;
+                        }
+                        platform::select_layout(&layout)
+                            && valid()
+                            && platform::current_layout().as_deref() == Some(layout.as_str())
+                    })
+                    .unwrap_or(false);
+                }
+                if !layout_ok {
+                    if let Ok(mut engine) = e.lock() {
+                        engine.invalidate_caret();
+                    }
+                    log::info!("text corrected; input-source change was not confirmed");
+                }
+                if gen.load(Ordering::SeqCst) == pending.generation
+                    && SETTINGS_REVISION.load(Ordering::SeqCst) == pending.revision
+                {
+                    let t = Track {
+                        focus: after,
+                        tail: text.clone(),
+                        revision: pending.revision,
+                        synchronized: true,
+                    };
+                    if let Some(x) = expectation(&t) {
+                        w.expect(vec![x]);
+                        if let Ok(mut slot) = tracker.lock() {
+                            *slot = Some(t);
+                        }
+                    }
+                } else {
+                    reset(&e, &tracker, &w);
+                }
+                log::info!(
+                    "AX correction applied ({} chars); compatible observed fields only",
+                    text.chars().count()
+                );
+            }
+        })
+        .map_err(|err| rekey_hook::HookError::Os(err.to_string()))?;
+    let handle = app.clone();
+    let flag = running.clone();
+    let shutdown_engine = engine.clone();
+    let shutdown_track = tracking.clone();
+    let shutdown_watch = watch.clone();
+    let shutdown_gen = generation.clone();
+    std::thread::Builder::new()
+        .name("rekey-safe-hook".into())
+        .spawn(move || {
+            while !platform::has_permission() {
+                std::thread::sleep(Duration::from_secs(1));
+            }
+            flag.store(true, Ordering::SeqCst);
+            let result = platform::run(move |event| {
+                if event.synthetic {
+                    return;
+                }
+                let n = generation.fetch_add(1, Ordering::SeqCst) + 1;
+                let revision = SETTINGS_REVISION.load(Ordering::SeqCst);
+                if watch.invalidated.swap(false, Ordering::SeqCst) {
+                    reset(&engine, &tracking, &watch);
+                }
+                // Publish the exact old/current-event after transition before any
+                // main-thread wait. AX notifications may already observe this event.
+                let old = tracking.lock().ok().and_then(|x| x.clone());
+                let transition = old
+                    .as_ref()
+                    .filter(|t| t.revision == revision)
+                    .and_then(|t| candidate(t, &event).map(|after| (t.clone(), after)));
+                if let Some((before, after)) = &transition {
+                    let states: Option<Vec<_>> = [expectation(before), expectation(after)]
+                        .into_iter()
+                        .collect();
+                    let Some(states) = states else {
+                        reset(&engine, &tracking, &watch);
+                        return;
+                    };
+                    watch.expect(states);
+                } else {
+                    reset(&engine, &tracking, &watch);
+                }
+                let bootstrap_scope = if transition.is_none() {
+                    let Some(scope) = watch.begin_bootstrap(n, revision) else {
+                        reset(&engine, &tracking, &watch);
+                        return;
+                    };
+                    Some(scope)
+                } else {
+                    None
+                };
+                let Some((ctx, pid)) = policy_context(&handle) else {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                };
+                if !allowed(&engine, &ctx) || gen_changed(&generation, n, revision) {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                }
+                let Some(focus) = Focus::capture() else {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                };
+                if focus.pid != pid || !watch.ensure(&focus) {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                }
+                let (before, t) = match transition {
+                    Some((before, after)) => {
+                        if crate::input_phase::reconcile(
+                            &state(&before),
+                            &state(&after),
+                            matches(&before, &focus),
+                            matches(&after, &focus),
+                        )
+                        .is_none()
+                        {
+                            reset(&engine, &tracking, &watch);
+                            return;
+                        }
+                        (before, after)
+                    }
+                    None => {
+                        let Some(pair) = bootstrap(&focus, &event, revision) else {
+                            reset(&engine, &tracking, &watch);
+                            return;
+                        };
+                        pair
+                    }
+                };
+                let boundary = before.synchronized;
+                let states: Option<Vec<_>> = [expectation(&before), expectation(&t)]
+                    .into_iter()
+                    .collect();
+                let Some(states) = states else {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                };
+                watch.expect(states);
+                if let Some(scope) = bootstrap_scope {
+                    let hints = scope.finish();
+                    // Deferred hints never authorize input: close their scope, then
+                    // re-capture exact phase/content with normal observer guards live.
+                    if hints == u64::MAX
+                        || !Focus::capture().is_some_and(|now| {
+                            crate::input_phase::confirm_bootstrap(
+                                &state(&before),
+                                &state(&t),
+                                |caret| boundary_at(&now, caret, revision),
+                                |s| {
+                                    if *s == state(&before) {
+                                        matches(&before, &now)
+                                    } else {
+                                        matches(&t, &now)
+                                    }
+                                },
+                            )
+                            .is_some()
+                        })
+                    {
+                        reset(&engine, &tracking, &watch);
+                        return;
+                    }
+                }
+
+                if !allowed(&engine, &ctx) {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                }
+                if gen_changed(&generation, n, revision) {
+                    reset(&engine, &tracking, &watch);
+                    return;
+                }
+                let action = match engine.lock() {
+                    Ok(mut e) => {
+                        // AX can block and trigger observer invalidation. Sample
+                        // all atomics only AFTER the last AX/policy operation.
+                        let policy_allowed = e.config().enabled
+                            && ctx
+                                .app
+                                .as_ref()
+                                .is_some_and(|a| !e.config().is_excluded_app(a));
+                        let fence = crate::input_phase::after_probe(
+                            || focus.still_focused(),
+                            || crate::input_phase::Fence {
+                                expected_generation: n,
+                                generation: generation.load(Ordering::SeqCst),
+                                expected_revision: revision,
+                                revision: SETTINGS_REVISION.load(Ordering::SeqCst),
+                                secure: platform::secure_input_active(),
+                                same_field: false, // set only by the completed probe
+                                allowed: policy_allowed,
+                            },
+                        );
+                        let Some(action) = crate::input_phase::deliver(fence, || {
+                            if boundary {
+                                e.on_key(&event, &ctx)
+                            } else {
+                                e.invalidate_caret();
+                                Action::None
+                            }
+                        }) else {
+                            drop(e);
+                            reset(&engine, &tracking, &watch);
+                            return;
+                        };
+                        action
+                    }
+                    Err(_) => return,
+                };
+                if let Ok(mut slot) = tracking.lock() {
+                    *slot = Some(t.clone());
+                }
+                if matches!(action, Action::Replace { .. }) {
+                    let _ = tx.send(Pending {
+                        action,
+                        origin: t.focus,
+                        generation: n,
+                        revision,
+                    });
+                }
+            });
+            flag.store(false, Ordering::SeqCst);
+            shutdown_gen.fetch_add(1, Ordering::SeqCst);
+            invalidate_pending();
+            reset(&shutdown_engine, &shutdown_track, &shutdown_watch);
+            if let Err(err) = result {
+                log::error!("safe keyboard hook stopped: {err}");
+            }
+        })
+        .map_err(|err| rekey_hook::HookError::Os(err.to_string()))?;
+    Ok(running)
+}
+fn gen_changed(generation: &AtomicU64, n: u64, revision: u64) -> bool {
+    generation.load(Ordering::SeqCst) != n || SETTINGS_REVISION.load(Ordering::SeqCst) != revision
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn missed_prefix_requires_whitespace_before_tracking() {
+        assert!(!crate::input_phase::known_boundary(5, Some("g")));
+        assert!(!crate::input_phase::known_boundary(5, None));
+        assert!(crate::input_phase::known_boundary(5, Some(" ")));
+    }
+    #[test]
+    fn empty_field_is_a_known_boundary() {
+        assert!(crate::input_phase::known_boundary(0, None));
+    }
+    #[test]
+    fn overflow_reset_does_not_license_suffix_correction() {
+        assert!(!crate::input_phase::known_boundary(129, Some("x")));
+        assert!(crate::input_phase::known_boundary(130, Some(" ")));
+    }
+}
diff --git a/app/src-tauri/src/transaction.rs b/app/src-tauri/src/transaction.rs
new file mode 100644
index 0000000..fdd443b
--- /dev/null
+++ b/app/src-tauri/src/transaction.rs
@@ -0,0 +1,244 @@
+//! Shared transaction orchestration, exercised with a stateful AX mock.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase {
+    BeforeSelection,
+    BeforeReplacement,
+    Rollback,
+}
+pub trait Target {
+    fn guard(&mut self, phase: Phase) -> bool;
+    fn fragment(&mut self) -> Option<String>;
+    fn select(&mut self) -> bool;
+    fn replace(&mut self) -> bool;
+    fn rollback(&mut self) -> bool;
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum Outcome {
+    Replaced,
+    Skipped,
+    SelectionRestored,
+    SelectionNotRestored,
+}
+pub fn execute(target: &mut impl Target, original: &str) -> Outcome {
+    if !target.guard(Phase::BeforeSelection)
+        || target.fragment().as_deref() != Some(original)
+        || !target.guard(Phase::BeforeSelection)
+    {
+        return Outcome::Skipped;
+    }
+    if !target.select() {
+        return Outcome::Skipped;
+    }
+    // A collapsed original caret is never acceptable once selection has been made.
+    // The backend performs fast combined retained-target/range/fragment guards.
+    if target.replace() {
+        return Outcome::Replaced;
+    }
+    // Restoration needs unchanged originating focus, revision, range and fragment.
+    if target.rollback() {
+        Outcome::SelectionRestored
+    } else {
+        Outcome::SelectionNotRestored
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[derive(Clone, Copy)]
+    enum Change {
+        None,
+        Focus,
+        Collapsed,
+        Settings,
+        TapLost,
+        Timeout,
+        Fragment,
+        Deleted,
+        NewInput,
+        Secure,
+        Toggle,
+        SelectFailure,
+        ReplaceFailure,
+        HostInput,
+    }
+    struct Mock {
+        step: usize,
+        at: usize,
+        change: Change,
+        live: bool,
+        selected: bool,
+        revision: bool,
+        fragment: String,
+        writes: usize,
+        restores: usize,
+        host_replacements: usize,
+    }
+    impl Mock {
+        fn new(change: Change, at: usize) -> Self {
+            Self {
+                step: 0,
+                at,
+                change,
+                live: true,
+                selected: false,
+                revision: true,
+                fragment: "ghbdtn ".into(),
+                writes: 0,
+                restores: 0,
+                host_replacements: 0,
+            }
+        }
+        fn advance(&mut self) {
+            self.step += 1;
+            if self.step == self.at {
+                match self.change {
+                    Change::None => {}
+                    Change::Collapsed => self.selected = false,
+                    Change::Fragment => self.fragment = "different".into(),
+                    Change::Settings => self.revision = false,
+                    Change::HostInput => {
+                        if self.selected {
+                            self.fragment = "z".into();
+                            self.selected = false;
+                            self.host_replacements += 1;
+                        }
+                        self.revision = false;
+                        self.live = false;
+                    }
+                    Change::TapLost | Change::Timeout | Change::NewInput => {
+                        self.revision = false;
+                        self.live = false;
+                    }
+                    _ => self.live = false,
+                }
+            }
+        }
+    }
+    impl Target for Mock {
+        fn guard(&mut self, p: Phase) -> bool {
+            self.advance();
+            self.live
+                && self.revision
+                && if p == Phase::BeforeSelection {
+                    !self.selected
+                } else {
+                    self.selected
+                }
+        }
+        fn fragment(&mut self) -> Option<String> {
+            self.advance();
+            self.live.then(|| self.fragment.clone())
+        }
+        fn select(&mut self) -> bool {
+            self.advance();
+            if matches!(self.change, Change::SelectFailure) {
+                false
+            } else {
+                self.selected = true;
+                true
+            }
+        }
+        fn replace(&mut self) -> bool {
+            self.advance();
+            if !self.live
+                || !self.revision
+                || !self.selected
+                || self.fragment != "ghbdtn "
+                || matches!(self.change, Change::ReplaceFailure)
+            {
+                return false;
+            }
+            self.writes += 1;
+            self.selected = false;
+            true
+        }
+        fn rollback(&mut self) -> bool {
+            self.advance();
+            if !self.live
+                || (!self.revision && !matches!(self.change, Change::Settings))
+                || !self.selected
+                || self.fragment != "ghbdtn "
+            {
+                return false;
+            }
+            self.selected = false;
+            self.restores += 1;
+            true
+        }
+    }
+    #[test]
+    fn exact_origin_replaces() {
+        let mut m = Mock::new(Change::None, usize::MAX);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::Replaced);
+        assert_eq!(m.writes, 1);
+    }
+    #[test]
+    fn original_fragment_mismatch_skips() {
+        let mut m = Mock::new(Change::None, usize::MAX);
+        m.fragment = "another".into();
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::Skipped);
+        assert_eq!(m.writes, 0);
+    }
+    #[test]
+    fn adversarial_transitions_at_every_check() {
+        for change in [
+            Change::Focus,
+            Change::Settings,
+            Change::TapLost,
+            Change::Timeout,
+            Change::Fragment,
+            Change::Deleted,
+            Change::NewInput,
+            Change::Secure,
+            Change::Toggle,
+        ] {
+            for at in 1..=5 {
+                let mut m = Mock::new(change, at);
+                let _ = execute(&mut m, "ghbdtn ");
+                assert_eq!(m.writes, 0, "write after transition at {at}");
+            }
+        }
+    }
+    #[test]
+    fn collapsed_selection_never_inserts() {
+        for at in 5..=5 {
+            let mut m = Mock::new(Change::Collapsed, at);
+            let _ = execute(&mut m, "ghbdtn ");
+            assert_eq!(m.writes, 0);
+        }
+    }
+    #[test]
+    fn selection_failure_has_no_writes() {
+        let mut m = Mock::new(Change::SelectFailure, usize::MAX);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::Skipped);
+        assert_eq!(m.writes, 0);
+    }
+    #[test]
+    fn replace_failure_restores_only_unchanged_selection() {
+        let mut m = Mock::new(Change::ReplaceFailure, usize::MAX);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::SelectionRestored);
+        assert_eq!(m.restores, 1);
+        assert_eq!(m.writes, 0);
+    }
+    #[test]
+    fn cancellation_does_not_blindly_restore() {
+        let mut m = Mock::new(Change::NewInput, 5);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::SelectionNotRestored);
+        assert_eq!(m.restores, 0);
+    }
+    #[test]
+    fn host_input_in_selection_window_is_detected_without_more_writes() {
+        let mut m = Mock::new(Change::HostInput, 5);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::SelectionNotRestored);
+        assert_eq!(m.writes, 0);
+        assert_eq!(m.host_replacements, 1);
+        assert_eq!(m.fragment, "z");
+    }
+    #[test]
+    fn config_only_cancel_collapses_owned_selection_without_new_capture() {
+        let mut m = Mock::new(Change::Settings, 5);
+        assert_eq!(execute(&mut m, "ghbdtn "), Outcome::SelectionRestored);
+        assert_eq!(m.writes, 0);
+        assert_eq!(m.restores, 1);
+    }
+}
diff --git a/crates/rekey-hook/src/focus.rs b/crates/rekey-hook/src/focus.rs
new file mode 100644
index 0000000..7d2afda
--- /dev/null
+++ b/crates/rekey-hook/src/focus.rs
@@ -0,0 +1,572 @@
+//! Conservative AX-targeted operations. Reads only bounded originating fragments.
+use core_foundation::{
+    base::{CFEqual, CFGetTypeID, CFRelease, CFTypeRef, TCFType},
+    runloop::{kCFRunLoopDefaultMode, CFRunLoop, CFRunLoopAddSource, CFRunLoopRemoveSource},
+    string::{CFString, CFStringGetTypeID, CFStringRef},
+};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        mpsc, Arc, Mutex,
+    },
+    time::Duration,
+};
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Range {
+    pub location: isize,
+    pub length: isize,
+}
+#[link(name = "ApplicationServices", kind = "framework")]
+unsafe extern "C" {
+    fn AXUIElementCreateSystemWide() -> CFTypeRef;
+    fn AXUIElementCreateApplication(pid: i32) -> CFTypeRef;
+    fn AXUIElementGetTypeID() -> usize;
+    fn AXValueGetTypeID() -> usize;
+    fn AXValueGetType(value: CFTypeRef) -> i32;
+    fn AXUIElementCopyAttributeValue(e: CFTypeRef, attr: CFStringRef, out: *mut CFTypeRef) -> i32;
+    fn AXUIElementCopyParameterizedAttributeValue(
+        e: CFTypeRef,
+        attr: CFStringRef,
+        param: CFTypeRef,
+        out: *mut CFTypeRef,
+    ) -> i32;
+    fn AXUIElementSetAttributeValue(e: CFTypeRef, attr: CFStringRef, value: CFTypeRef) -> i32;
+    fn AXUIElementGetPid(e: CFTypeRef, pid: *mut i32) -> i32;
+    fn AXUIElementSetMessagingTimeout(e: CFTypeRef, seconds: f32) -> i32;
+    fn AXUIElementIsAttributeSettable(e: CFTypeRef, attr: CFStringRef, out: *mut bool) -> i32;
+    fn AXValueGetValue(value: CFTypeRef, kind: i32, out: *mut c_void) -> bool;
+    fn AXValueCreate(kind: i32, value: *const c_void) -> CFTypeRef;
+    fn AXObserverCreate(
+        pid: i32,
+        callback: unsafe extern "C" fn(CFTypeRef, CFTypeRef, CFStringRef, *mut c_void),
+        out: *mut CFTypeRef,
+    ) -> i32;
+    fn AXObserverAddNotification(
+        observer: CFTypeRef,
+        e: CFTypeRef,
+        name: CFStringRef,
+        refcon: *mut c_void,
+    ) -> i32;
+    fn AXObserverGetRunLoopSource(
+        observer: CFTypeRef,
+    ) -> core_foundation::runloop::CFRunLoopSourceRef;
+}
+// Generic owned CF references remain local to the thread; no blanket Send/Sync.
+struct Owned(CFTypeRef);
+impl Drop for Owned {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { CFRelease(self.0) }
+        }
+    }
+}
+struct AXElement(Owned);
+// Apple AXUIElement references are thread-safe; only validated AX references cross threads.
+unsafe impl Send for AXElement {}
+unsafe impl Sync for AXElement {}
+impl AXElement {
+    fn from_owned(x: Owned) -> Option<Self> {
+        if !x.0.is_null() && unsafe { CFGetTypeID(x.0) == AXUIElementGetTypeID() } {
+            Some(Self(x))
+        } else {
+            None
+        }
+    }
+    fn raw(&self) -> CFTypeRef {
+        self.0 .0
+    }
+}
+fn attr(e: &AXElement, name: &str) -> Option<Owned> {
+    let mut out = std::ptr::null();
+    if unsafe {
+        AXUIElementCopyAttributeValue(e.raw(), CFString::new(name).as_concrete_TypeRef(), &mut out)
+    } == 0
+        && !out.is_null()
+    {
+        Some(Owned(out))
+    } else {
+        None
+    }
+}
+fn optional_attr(e: &AXElement, name: &str) -> Result<Option<Owned>, i32> {
+    let mut out = std::ptr::null();
+    let status = unsafe {
+        AXUIElementCopyAttributeValue(e.raw(), CFString::new(name).as_concrete_TypeRef(), &mut out)
+    };
+    match status {
+        0 if !out.is_null() => Ok(Some(Owned(out))),
+        -25205 | -25212 => Ok(None),
+        other => Err(other),
+    }
+}
+fn string(x: &Owned) -> Option<String> {
+    if unsafe { CFGetTypeID(x.0) != CFStringGetTypeID() } {
+        return None;
+    }
+    Some(unsafe { CFString::wrap_under_get_rule(x.0 as CFStringRef) }.to_string())
+}
+fn range(x: &Owned) -> Option<Range> {
+    if unsafe { CFGetTypeID(x.0) != AXValueGetTypeID() || AXValueGetType(x.0) != 4 } {
+        return None;
+    }
+    let mut r = Range {
+        location: -1,
+        length: -1,
+    };
+    if unsafe { AXValueGetValue(x.0, 4, &mut r as *mut _ as *mut c_void) }
+        && r.location >= 0
+        && r.length >= 0
+    {
+        Some(r)
+    } else {
+        None
+    }
+}
+fn range_value(r: Range) -> Option<Owned> {
+    let x = Owned(unsafe { AXValueCreate(4, &r as *const _ as *const c_void) });
+    (!x.0.is_null()).then_some(x)
+}
+#[derive(Clone)]
+pub struct Focus {
+    field: Arc<AXElement>,
+    window: Arc<AXElement>,
+    pub pid: i32,
+    pub caret: usize,
+    pub selected: usize,
+}
+impl Focus {
+    pub fn same_field(&self, other: &Self) -> bool {
+        self.pid == other.pid
+            && unsafe {
+                CFEqual(self.field.raw(), other.field.raw()) != 0
+                    && CFEqual(self.window.raw(), other.window.raw()) != 0
+            }
+    }
+    pub fn selection(&self) -> Range {
+        Range {
+            location: self.caret as isize,
+            length: self.selected as isize,
+        }
+    }
+    pub fn with_range(&self, r: Range) -> Self {
+        let mut f = self.clone();
+        f.caret = r.location as usize;
+        f.selected = r.length as usize;
+        f
+    }
+    pub fn capture() -> Option<Self> {
+        if super::macos::secure_input_active() {
+            return None;
+        }
+        let root = AXElement::from_owned(Owned(unsafe { AXUIElementCreateSystemWide() }))?;
+        unsafe {
+            AXUIElementSetMessagingTimeout(root.raw(), 0.025);
+        }
+        let field = Arc::new(AXElement::from_owned(attr(&root, "AXFocusedUIElement")?)?);
+        unsafe {
+            AXUIElementSetMessagingTimeout(field.raw(), 0.005);
+        }
+        let role = string(&attr(&field, "AXRole")?)?;
+        if role != "AXTextField" && role != "AXTextArea" {
+            return None;
+        }
+        match optional_attr(&field, "AXSubrole") {
+            Ok(Some(subrole)) => {
+                if string(&subrole)?.contains("Secure") {
+                    return None;
+                }
+            }
+            Ok(None) => {}
+            Err(_) => return None,
+        }
+        for key in ["AXSelectedText", "AXSelectedTextRange"] {
+            let mut yes = false;
+            if unsafe {
+                AXUIElementIsAttributeSettable(
+                    field.raw(),
+                    CFString::new(key).as_concrete_TypeRef(),
+                    &mut yes,
+                )
+            } != 0
+                || !yes
+            {
+                return None;
+            }
+        }
+        let selection = range(&attr(&field, "AXSelectedTextRange")?)?;
+        let window = Arc::new(AXElement::from_owned(attr(&field, "AXWindow")?)?);
+        let mut pid = 0;
+        if unsafe { AXUIElementGetPid(field.raw(), &mut pid) } != 0 || pid <= 0 {
+            return None;
+        }
+        Some(Self {
+            field,
+            window,
+            pid,
+            caret: selection.location as usize,
+            selected: selection.length as usize,
+        })
+    }
+    /// Reads only the exact requested fragment (max128UTF16units), never AXValue.
+    pub fn fragment(&self, r: Range) -> Option<String> {
+        if r.location < 0 || r.length < 0 || r.length > 128 {
+            return None;
+        }
+        let parameter = range_value(r)?;
+        let mut out = std::ptr::null();
+        if unsafe {
+            AXUIElementCopyParameterizedAttributeValue(
+                self.field.raw(),
+                CFString::new("AXStringForRange").as_concrete_TypeRef(),
+                parameter.0,
+                &mut out,
+            )
+        } != 0
+            || out.is_null()
+        {
+            return None;
+        }
+        string(&Owned(out))
+    }
+    /// Fast post-selection checks avoid main-thread dispatch and full metadata capture.
+    pub fn still_focused(&self) -> bool {
+        if super::macos::secure_input_active() {
+            return false;
+        }
+        let Some(root) = AXElement::from_owned(Owned(unsafe { AXUIElementCreateSystemWide() }))
+        else {
+            return false;
+        };
+        unsafe {
+            AXUIElementSetMessagingTimeout(root.raw(), 0.005);
+        }
+        let Some(raw) = attr(&root, "AXFocusedUIElement") else {
+            return false;
+        };
+        let Some(current) = AXElement::from_owned(raw) else {
+            return false;
+        };
+        unsafe { CFEqual(current.raw(), self.field.raw()) != 0 }
+    }
+    pub fn current_range(&self) -> Option<Range> {
+        range(&attr(&self.field, "AXSelectedTextRange")?)
+    }
+    pub fn set_selection(&self, r: Range) -> bool {
+        let Some(v) = range_value(r) else {
+            return false;
+        };
+        (unsafe {
+            AXUIElementSetAttributeValue(
+                self.field.raw(),
+                CFString::new("AXSelectedTextRange").as_concrete_TypeRef(),
+                v.0,
+            )
+        }) == 0
+    }
+    pub fn set_selected_text(&self, text: &str) -> bool {
+        (unsafe {
+            AXUIElementSetAttributeValue(
+                self.field.raw(),
+                CFString::new("AXSelectedText").as_concrete_TypeRef(),
+                CFString::new(text).as_CFTypeRef(),
+            )
+        }) == 0
+    }
+}
+#[derive(Clone)]
+pub struct Expected {
+    pub focus: Focus,
+    pub fragment_range: Range,
+    pub fragment: String,
+    pub revision: u64,
+}
+impl Expected {
+    pub fn matches(&self, now: &Focus, policy: impl Fn(u64) -> bool) -> bool {
+        policy(self.revision)
+            && now.same_field(&self.focus)
+            && now.selection() == self.focus.selection()
+            && policy(self.revision)
+            && ((self.fragment_range.length == 0 && self.fragment.is_empty())
+                || now.fragment(self.fragment_range).as_deref() == Some(self.fragment.as_str()))
+    }
+}
+/// Only text/selection notifications can be deferred while one bootstrap event
+/// is being reconciled. Focus/window changes and stale policy always invalidate.
+#[derive(Default)]
+pub struct BootstrapState {
+    scope: Mutex<Option<(u64, u64)>>,
+    hints: AtomicU64,
+}
+impl BootstrapState {
+    pub fn begin(self: &Arc<Self>, generation: u64, revision: u64) -> Option<BootstrapGuard> {
+        let mut scope = self.scope.lock().ok()?;
+        if scope.is_some() {
+            return None;
+        }
+        self.hints.store(0, Ordering::SeqCst);
+        *scope = Some((generation, revision));
+        Some(BootstrapGuard {
+            state: self.clone(),
+            token: (generation, revision),
+        })
+    }
+    pub fn defer_hint(
+        &self,
+        focus_change: bool,
+        generation: u64,
+        policy: impl Fn(u64) -> bool,
+    ) -> bool {
+        if focus_change {
+            return false;
+        }
+        let Ok(scope) = self.scope.lock() else {
+            return false;
+        };
+        if scope
+            .as_ref()
+            .is_some_and(|(g, r)| *g == generation && policy(*r))
+        {
+            self.hints.fetch_add(1, Ordering::SeqCst);
+            true
+        } else {
+            false
+        }
+    }
+}
+pub struct BootstrapGuard {
+    state: Arc<BootstrapState>,
+    token: (u64, u64),
+}
+impl BootstrapGuard {
+    pub fn finish(self) -> u64 {
+        // Closing the scope and taking its count is synchronized with callbacks.
+        let Ok(mut scope) = self.state.scope.lock() else {
+            return u64::MAX;
+        };
+        if *scope != Some(self.token) {
+            return u64::MAX;
+        }
+        *scope = None;
+        self.state.hints.load(Ordering::SeqCst)
+    }
+}
+impl Drop for BootstrapGuard {
+    fn drop(&mut self) {
+        if let Ok(mut scope) = self.state.scope.lock() {
+            if *scope == Some(self.token) {
+                *scope = None;
+            }
+        }
+    }
+}
+struct WatchState {
+    bootstrap: Arc<BootstrapState>,
+    generation: Arc<AtomicU64>,
+    invalidated: Arc<AtomicBool>,
+    expected: Arc<Mutex<Vec<Expected>>>,
+    policy: Arc<dyn Fn(u64) -> bool + Send + Sync>,
+}
+unsafe extern "C" fn notify(
+    _observer: CFTypeRef,
+    _element: CFTypeRef,
+    name: CFStringRef,
+    refcon: *mut c_void,
+) {
+    if refcon.is_null() {
+        return;
+    }
+    let state = unsafe { &*(refcon as *const WatchState) };
+    // A notification is only an invalidation hint; payload text is never read.
+    let focus_change =
+        if name.is_null() || unsafe { CFGetTypeID(name as CFTypeRef) != CFStringGetTypeID() } {
+            true
+        } else {
+            unsafe { CFString::wrap_under_get_rule(name) }
+                .to_string()
+                .contains("Focused")
+        };
+    if state
+        .bootstrap
+        .defer_hint(focus_change, state.generation.load(Ordering::SeqCst), |r| {
+            (state.policy)(r)
+        })
+    {
+        // No text read or authorization here. The hook must re-capture and
+        // strictly reconcile after closing this scope before delivering input.
+        return;
+    }
+    let matches = !focus_change
+        && Focus::capture().is_some_and(|now| {
+            state.expected.lock().ok().is_some_and(|xs| {
+                xs.iter()
+                    .any(|x| x.matches(&now, |revision| (state.policy)(revision)))
+            })
+        });
+    if !matches {
+        state.generation.fetch_add(1, Ordering::SeqCst);
+        state.invalidated.store(true, Ordering::SeqCst);
+    }
+}
+#[derive(Clone)]
+pub struct Watch {
+    bootstrap: Arc<BootstrapState>,
+    tx: mpsc::Sender<Focus>,
+    ready: Arc<Mutex<Option<Focus>>>,
+    expected: Arc<Mutex<Vec<Expected>>>,
+    pub invalidated: Arc<AtomicBool>,
+}
+impl Watch {
+    pub fn start(
+        generation: Arc<AtomicU64>,
+        policy: Arc<dyn Fn(u64) -> bool + Send + Sync>,
+    ) -> Result<Self, std::io::Error> {
+        let bootstrap = Arc::new(BootstrapState::default());
+        let boot = bootstrap.clone();
+        let (tx, rx) = mpsc::channel::<Focus>();
+        let ready = Arc::new(Mutex::new(None));
+        let expected = Arc::new(Mutex::new(Vec::new()));
+        let invalidated = Arc::new(AtomicBool::new(false));
+        let r = ready.clone();
+        let xs = expected.clone();
+        let invalid = invalidated.clone();
+        std::thread::Builder::new()
+            .name("rekey-ax-observer".into())
+            .spawn(move || {
+                let state = Box::new(WatchState {
+                    bootstrap: boot,
+                    generation: generation.clone(),
+                    invalidated: invalid,
+                    expected: xs,
+                    policy,
+                });
+                let refcon = (&*state as *const WatchState) as *mut c_void;
+                let runloop = CFRunLoop::get_current();
+                let mut observer: Option<Owned> = None;
+                let mut installed: Option<Focus> = None;
+                loop {
+                    match rx.recv_timeout(Duration::from_millis(10)) {
+                        Ok(focus) => {
+                            if installed.as_ref().is_some_and(|x| x.same_field(&focus)) {
+                                continue;
+                            }
+                            if let Some(old) = observer.take() {
+                                unsafe {
+                                    CFRunLoopRemoveSource(
+                                        runloop.as_concrete_TypeRef(),
+                                        AXObserverGetRunLoopSource(old.0),
+                                        kCFRunLoopDefaultMode,
+                                    );
+                                }
+                                drop(old);
+                            }
+                            installed = None;
+                            if let Ok(mut slot) = r.lock() {
+                                *slot = None;
+                            }
+                            let mut raw = std::ptr::null();
+                            if unsafe { AXObserverCreate(focus.pid, notify, &mut raw) } != 0
+                                || raw.is_null()
+                            {
+                                continue;
+                            }
+                            let own = Owned(raw);
+                            let Some(app) = AXElement::from_owned(Owned(unsafe {
+                                AXUIElementCreateApplication(focus.pid)
+                            })) else {
+                                continue;
+                            };
+                            let mut ok = true;
+                            for (element, name) in [
+                                (&app, "AXFocusedUIElementChanged"),
+                                (&app, "AXFocusedWindowChanged"),
+                                (&*focus.field, "AXSelectedTextChanged"),
+                                (&*focus.field, "AXValueChanged"),
+                            ] {
+                                if unsafe {
+                                    AXObserverAddNotification(
+                                        own.0,
+                                        element.raw(),
+                                        CFString::new(name).as_concrete_TypeRef(),
+                                        refcon,
+                                    )
+                                } != 0
+                                {
+                                    ok = false;
+                                    break;
+                                }
+                            }
+                            if !ok {
+                                continue;
+                            }
+                            unsafe {
+                                CFRunLoopAddSource(
+                                    runloop.as_concrete_TypeRef(),
+                                    AXObserverGetRunLoopSource(own.0),
+                                    kCFRunLoopDefaultMode,
+                                );
+                            }
+                            installed = Some(focus.clone());
+                            observer = Some(own);
+                            if let Ok(mut slot) = r.lock() {
+                                *slot = Some(focus);
+                            }
+                        }
+                        Err(mpsc::RecvTimeoutError::Disconnected) => {
+                            generation.fetch_add(1, Ordering::SeqCst);
+                            if let Some(old) = observer.take() {
+                                unsafe {
+                                    CFRunLoopRemoveSource(
+                                        runloop.as_concrete_TypeRef(),
+                                        AXObserverGetRunLoopSource(old.0),
+                                        kCFRunLoopDefaultMode,
+                                    );
+                                }
+                            }
+                            break;
+                        }
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                    }
+                    if observer.is_some() {
+                        CFRunLoop::run_in_mode(
+                            unsafe { kCFRunLoopDefaultMode },
+                            Duration::from_millis(10),
+                            false,
+                        );
+                    }
+                }
+            })?;
+        Ok(Self {
+            bootstrap,
+            tx,
+            ready,
+            expected,
+            invalidated,
+        })
+    }
+    pub fn begin_bootstrap(&self, generation: u64, revision: u64) -> Option<BootstrapGuard> {
+        self.bootstrap.begin(generation, revision)
+    }
+    pub fn ensure(&self, focus: &Focus) -> bool {
+        if self
+            .ready
+            .lock()
+            .ok()
+            .is_some_and(|x| x.as_ref().is_some_and(|f| f.same_field(focus)))
+        {
+            true
+        } else {
+            let _ = self.tx.send(focus.clone());
+            false
+        }
+    }
+    pub fn expect(&self, xs: Vec<Expected>) {
+        if let Ok(mut x) = self.expected.lock() {
+            *x = xs;
+        }
+    }
+    pub fn clear(&self) {
+        self.expect(Vec::new());
+    }
+}
