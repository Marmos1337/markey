diff --git a/app/src-tauri/src/safe_service.rs b/app/src-tauri/src/safe_service.rs
new file mode 100644
--- /dev/null
+++ b/app/src-tauri/src/safe_service.rs
@@ -0,0 +1,115 @@
+//! Local safety fork: AX-targeted replacement only; unsupported fields fail closed.
+use rekey_core::{engine::{Action, Engine}, input::{Context, Key, KeyEvent}};
+use rekey_hook::{focus::Focus, platform};
+use std::{sync::{Arc, Mutex, atomic::{AtomicBool, AtomicU64, Ordering}, mpsc}, time::Duration};
+use tauri::AppHandle;
+pub type SharedEngine = Arc<Mutex<Engine>>;
+static SETTINGS_REVISION: AtomicU64 = AtomicU64::new(0);
+pub fn invalidate_pending() { SETTINGS_REVISION.fetch_add(1, Ordering::SeqCst); }
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Stamp { pid: i32, caret: usize, selected: usize, secure: bool, excluded: bool, enabled: bool, generation: u64 }
+fn eligible(origin: &Stamp, current: &Stamp, same_field: bool) -> bool {
+    same_field && origin.pid == current.pid && origin.caret == current.caret && current.selected == 0 && !current.secure && !current.excluded && current.enabled && origin.generation == current.generation
+}
+fn on_main<T: Send + 'static>(app: &AppHandle, f: impl FnOnce()->T + Send + 'static) -> Option<T> {
+    let (tx,rx)=mpsc::channel(); app.run_on_main_thread(move || { let _=tx.send(f()); }).ok()?;
+    rx.recv_timeout(Duration::from_millis(200)).ok()
+}
+fn next_caret(focus: &Focus, event: &KeyEvent) -> Option<usize> {
+    if focus.selected != 0 || event.modifiers.is_shortcut() { return None; }
+    match event.key {
+        Key::Character if event.character?.len_utf16() == 1 => Some(focus.caret + 1),
+        Key::Space => Some(focus.caret+1),
+        Key::ModifiersChanged => Some(focus.caret),
+        // Backspace and navigation discard the remembered text conservatively.
+        _=>None,
+    }
+}
+struct Pending { action: Action, origin: Focus, generation: u64, settings_revision: u64 }
+fn allowed(engine: &SharedEngine, ctx: &Context) -> bool {
+    let Ok(e)=engine.lock() else { return false; };
+    e.config().enabled && !ctx.secure_input && ctx.app.as_ref().is_some_and(|a| !e.config().is_excluded_app(a))
+}
+fn reset(engine: &SharedEngine, tracking: &Arc<Mutex<Option<Focus>>>) {
+    if let Ok(mut e)=engine.lock() { e.invalidate_caret(); }
+    if let Ok(mut t)=tracking.lock() { *t=None; }
+}
+pub fn spawn(app: &AppHandle, engine: SharedEngine) -> Result<Arc<AtomicBool>, rekey_hook::HookError> {
+    let running=Arc::new(AtomicBool::new(false));
+    let generation=Arc::new(AtomicU64::new(0));
+    let tracking=Arc::new(Mutex::new(None::<Focus>));
+    let (tx,rx)=mpsc::channel::<Pending>();
+    let handle=app.clone(); let gen=generation.clone(); let e=engine.clone(); let tracker=tracking.clone();
+    std::thread::Builder::new().name("rekey-safe-inject".into()).spawn(move || {
+        for pending in rx {
+            std::thread::sleep(Duration::from_millis(25));
+            let Action::Replace { delete, text, switch_to }=&pending.action else { continue; };
+            let guard = || {
+                if gen.load(Ordering::SeqCst)!=pending.generation || SETTINGS_REVISION.load(Ordering::SeqCst)!=pending.settings_revision { return false; }
+                let Some(ctx)=on_main(&handle, platform::current_context) else { return false; };
+                if !allowed(&e,&ctx) { return false; }
+                let Some(now)=Focus::capture() else { return false; };
+                pending.origin.same_field(&now) && now.pid==pending.origin.pid && (
+                    (now.caret==pending.origin.caret && now.selected==0) ||
+                    (pending.origin.caret>=*delete && now.caret==pending.origin.caret-*delete && now.selected==*delete)) && gen.load(Ordering::SeqCst)==pending.generation
+            };
+            let Some(now)=Focus::capture() else { reset(&e,&tracker); continue; };
+            let origin=Stamp { pid:pending.origin.pid,caret:pending.origin.caret,selected:0,secure:false,excluded:false,enabled:true,generation:pending.generation };
+            let Some(ctx)=on_main(&handle,platform::current_context) else {reset(&e,&tracker);continue;};
+            let current=Stamp {pid:now.pid,caret:now.caret,selected:now.selected,secure:ctx.secure_input,excluded:!allowed(&e,&ctx),enabled:allowed(&e,&ctx),generation:gen.load(Ordering::SeqCst)};
+            if !eligible(&origin,&current,pending.origin.same_field(&now)) || !guard() { reset(&e,&tracker);continue; }
+            // A failed AX target never falls back to global keyboard events.
+            if !pending.origin.replace(*delete,text,guard) { reset(&e,&tracker);continue; }
+            if gen.load(Ordering::SeqCst)!=pending.generation {reset(&e,&tracker);continue;}
+            let Some(after)=Focus::capture() else {reset(&e,&tracker);continue;};
+            if !after.same_field(&pending.origin) || after.selected!=0 || after.caret!=pending.origin.caret-*delete+text.encode_utf16().count() {reset(&e,&tracker);continue;}
+            if let Some(layout)=switch_to {
+                let layout=layout.clone(); let target=after.clone(); let e=e.clone(); let gen=gen.clone(); let n=pending.generation;
+                let _=on_main(&handle,move || {
+                    if gen.load(Ordering::SeqCst)!=n || !allowed(&e,&platform::current_context()) { return false; }
+                    if !Focus::capture().is_some_and(|f| f.same_field(&target)&&f.caret==target.caret&&f.selected==0) {return false;}
+                    platform::select_layout(&layout)
+                });
+            }
+            if gen.load(Ordering::SeqCst)==pending.generation { if let Ok(mut t)=tracker.lock() {*t=Some(after);} }
+            log::info!("AX correction applied ({} chars); unsupported fields are skipped",text.chars().count());
+        }
+    }).map_err(|err|rekey_hook::HookError::Os(err.to_string()))?;
+    let handle=app.clone(); let flag=running.clone();
+    std::thread::Builder::new().name("rekey-safe-hook".into()).spawn(move || {
+        while !platform::has_permission() {std::thread::sleep(Duration::from_secs(1));}
+        flag.store(true,Ordering::Relaxed);
+        let result=platform::run(move |event| {
+            if event.synthetic {return;}
+            let n=generation.fetch_add(1,Ordering::SeqCst)+1;
+            let Some(mut focus)=Focus::capture() else {reset(&engine,&tracking);return;};
+            let Some(next)=next_caret(&focus,&event) else {reset(&engine,&tracking);return;};
+            let continuous=tracking.lock().ok().and_then(|t|t.clone()).is_some_and(|previous|previous.same_field(&focus)&&previous.caret==focus.caret&&focus.selected==0);
+            if !continuous {reset(&engine,&tracking);}
+            // AX APIs are thread-safe; TIS/AppKit context is queried on the main thread.
+            let Some(ctx)=on_main(&handle,platform::current_context) else {reset(&engine,&tracking);return;};
+            if !allowed(&engine,&ctx) {reset(&engine,&tracking);return;}
+            let action=match engine.lock() {Ok(mut e)=>e.on_key(&event,&ctx),Err(_)=>return};
+            focus.caret=next;
+            if let Ok(mut t)=tracking.lock() {*t=Some(focus.clone());}
+            if matches!(action,Action::Replace {..}) {let _=tx.send(Pending {action,origin:focus,generation:n,settings_revision:SETTINGS_REVISION.load(Ordering::SeqCst)});}
+        });
+        flag.store(false,Ordering::Relaxed);
+        if let Err(err)=result {log::error!("safe keyboard hook stopped: {err}");}
+    }).map_err(|err|rekey_hook::HookError::Os(err.to_string()))?;
+    Ok(running)
+}
+#[cfg(test)]
+mod tests {
+ use super::*;
+ fn origin()->Stamp {Stamp {pid:1,caret:6,selected:0,secure:false,excluded:false,enabled:true,generation:8}}
+ #[test] fn accepts_only_unchanged_target(){let a=origin();assert!(eligible(&a,&a,true));}
+ #[test] fn same_app_other_field_and_deleted_element(){let a=origin();assert!(!eligible(&a,&a,false));}
+ #[test] fn other_app(){let a=origin();let mut b=a.clone();b.pid=2;assert!(!eligible(&a,&b,true));}
+ #[test] fn secure_input(){let a=origin();let mut b=a.clone();b.secure=true;assert!(!eligible(&a,&b,true));}
+ #[test] fn excluded_app(){let a=origin();let mut b=a.clone();b.excluded=true;assert!(!eligible(&a,&b,true));}
+ #[test] fn toggle_off(){let a=origin();let mut b=a.clone();b.enabled=false;assert!(!eligible(&a,&b,true));}
+ #[test] fn new_input_cancels(){let a=origin();let mut b=a.clone();b.generation+=1;assert!(!eligible(&a,&b,true));}
+ #[test] fn mouse_selection_or_caret_move(){let a=origin();let mut b=a.clone();b.selected=1;assert!(!eligible(&a,&b,true));b.selected=0;b.caret-=1;assert!(!eligible(&a,&b,true));}
+}

diff --git a/crates/rekey-hook/src/focus.rs b/crates/rekey-hook/src/focus.rs
new file mode 100644
--- /dev/null
+++ b/crates/rekey-hook/src/focus.rs
@@ -0,0 +1,87 @@
+//! Conservative AX-targeted text replacement. Never reads a field's full value.
+use core_foundation::base::{CFEqual, CFRelease, CFTypeRef, TCFType};
+use core_foundation::string::{CFString, CFStringRef};
+use std::{ffi::c_void, sync::Arc};
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Range { location: isize, length: isize }
+#[link(name = "ApplicationServices", kind = "framework")]
+unsafe extern "C" {
+    fn AXUIElementCreateSystemWide() -> CFTypeRef;
+    fn AXUIElementCopyAttributeValue(e: CFTypeRef, attr: CFStringRef, out: *mut CFTypeRef) -> i32;
+    fn AXUIElementSetAttributeValue(e: CFTypeRef, attr: CFStringRef, value: CFTypeRef) -> i32;
+    fn AXUIElementGetPid(e: CFTypeRef, pid: *mut i32) -> i32;
+    fn AXUIElementSetMessagingTimeout(e: CFTypeRef, seconds: f32) -> i32;
+    fn AXValueGetValue(value: CFTypeRef, kind: i32, out: *mut c_void) -> bool;
+    fn AXValueCreate(kind: i32, value: *const c_void) -> CFTypeRef;
+    fn AXUIElementIsAttributeSettable(e: CFTypeRef, attr: CFStringRef, out: *mut bool) -> i32;
+}
+struct Owned(CFTypeRef);
+impl Drop for Owned { fn drop(&mut self) { if !self.0.is_null() { unsafe { CFRelease(self.0) } } } }
+// AXUIElement APIs are thread-safe. The reference is retained until the last snapshot drops.
+unsafe impl Send for Owned {}
+unsafe impl Sync for Owned {}
+fn attr(e: CFTypeRef, name: &str) -> Option<Owned> {
+    let key = CFString::new(name);
+    let mut out = std::ptr::null();
+    if unsafe { AXUIElementCopyAttributeValue(e, key.as_concrete_TypeRef(), &mut out) } == 0 && !out.is_null() { Some(Owned(out)) } else { None }
+}
+#[derive(Clone)]
+pub struct Focus {
+    field: Arc<Owned>,
+    pub pid: i32,
+    window: Arc<Owned>,
+    pub caret: usize,
+    pub selected: usize,
+}
+impl Focus {
+    pub fn same_field(&self, other: &Self) -> bool {
+        self.pid == other.pid && unsafe { CFEqual(self.window.0, other.window.0) != 0 && CFEqual(self.field.0, other.field.0) != 0 }
+    }
+    /// Fail closed for secure, missing, selected, or unsupported text fields.
+    pub fn capture() -> Option<Self> {
+        if super::macos::secure_input_active() { return None; }
+        let root = Owned(unsafe { AXUIElementCreateSystemWide() });
+        if root.0.is_null() { return None; }
+        unsafe { AXUIElementSetMessagingTimeout(root.0, 0.025); }
+        let field = attr(root.0, "AXFocusedUIElement")?;
+        unsafe { AXUIElementSetMessagingTimeout(field.0, 0.025); }
+        let role = attr(field.0, "AXRole")?;
+        let role = unsafe { CFString::wrap_under_get_rule(role.0 as CFStringRef) }.to_string();
+        if role != "AXTextArea" && role != "AXTextField" { return None; }
+        if let Some(subrole) = attr(field.0, "AXSubrole") {
+            let s = unsafe { CFString::wrap_under_get_rule(subrole.0 as CFStringRef) }.to_string();
+            if s == "AXSecureTextField" { return None; }
+        }
+        for key in ["AXSelectedText", "AXSelectedTextRange"] {
+            let mut settable = false;
+            if unsafe { AXUIElementIsAttributeSettable(field.0, CFString::new(key).as_concrete_TypeRef(), &mut settable) } != 0 || !settable { return None; }
+        }
+        let selection = attr(field.0, "AXSelectedTextRange")?;
+        let mut range = Range { location: -1, length: -1 };
+        if !unsafe { AXValueGetValue(selection.0, 4, &mut range as *mut _ as *mut c_void) } || range.location < 0 || range.length < 0 { return None; }
+        let window = attr(field.0, "AXWindow")?;
+        let mut pid = 0;
+        if unsafe { AXUIElementGetPid(field.0, &mut pid) } != 0 || pid <= 0 { return None; }
+        Some(Self { field: Arc::new(field), pid, window: Arc::new(window), caret: range.location as usize, selected: range.length as usize })
+    }
+    /// Replace only in the retained originating field. No global event fallback.
+    /// Every operation is guarded; a cancelled selection is never replaced.
+    pub fn replace(&self, delete: usize, text: &str, guard: impl Fn() -> bool) -> bool {
+        if self.selected != 0 || self.caret < delete || !guard() { return false; }
+        let range = Range { location: (self.caret-delete) as isize, length: delete as isize };
+        let value = Owned(unsafe { AXValueCreate(4, &range as *const _ as *const c_void) });
+        if value.0.is_null() || !guard() { return false; }
+        if unsafe { AXUIElementSetAttributeValue(self.field.0, CFString::new("AXSelectedTextRange").as_concrete_TypeRef(), value.0) } != 0 { return false; }
+        // The guard here checks identity, generation, exclusions and secure input;
+        // selection must now equal the exact range we just selected.
+        if !guard() { return false; }
+        let selection = match attr(self.field.0, "AXSelectedTextRange") { Some(s)=>s, None=>return false };
+        let mut actual = Range { location:-1, length:-1 };
+        if !unsafe { AXValueGetValue(selection.0, 4, &mut actual as *mut _ as *mut c_void) } || actual != range { return false; }
+        let replacement = CFString::new(text);
+        if !guard() { return false; }
+        (unsafe { AXUIElementSetAttributeValue(self.field.0, CFString::new("AXSelectedText").as_concrete_TypeRef(), replacement.as_CFTypeRef()) }) == 0
+    }
+}
