+        }
+        assert_eq!(received, 0);
+    }
+    #[test]
+    fn bootstrap_needs_phase_specific_boundary_not_blind_caret_subtraction() {
+        assert!(known_boundary(0, None));
+        assert!(known_boundary(4, Some(" ")));
