{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarKey",
  "version": "0.1.0",
  "identifier": "com.marmos.markey",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "MarKey",
        "width": 760,
        "height": 560,
        "resizable": true,
        "minimizable": true,
        "maximizable": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "center": true,
        "minWidth": 680,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../crates/rekey-core/data/models": "models"
    },
    "copyright": "© 2026 marmos. Based on Rekey © Rostislav Ladnov. MIT licensed.",
    "category": "Utility",
    "shortDescription": "Fixes text typed on the wrong keyboard layout.",
    "longDescription": "MarKey watches for words typed with the wrong keyboard layout — ghbdtn instead of привет — and rewrites them as you type. It runs entirely on your Mac.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
